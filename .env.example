# Copy this file to .env and set your own values. Never commit .env.
POSTGRES_DB=company_brain
POSTGRES_USER=company_brain
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend database connection (DATABASE_URL), read by backend/core/config.py.
# Use the same user, password and database as above. Pick the host for where the backend runs:
#   Backend on your machine (uvicorn):  localhost
#   Backend in Docker Compose:          db
#   LXC deployment:                     set in /etc/company-brain/backend.env with host 10.0.3.124
DATABASE_URL=postgresql://company_brain:change-me@localhost:5432/company_brain
