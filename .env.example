# Copy this file to .env and set your own values. Never commit .env.
POSTGRES_DB=company_brain
POSTGRES_USER=company_brain
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend running directly on your machine. Keep the credentials and port in sync above.
DATABASE_URL=postgresql://company_brain:change-me@localhost:5432/company_brain

# Docker Compose derives DATABASE_URL from POSTGRES_* with host db and port 5432.
# If credentials contain URL-reserved characters, set an override with encoded credentials:
# COMPOSE_DATABASE_URL=postgresql://company_brain:change-me@db:5432/company_brain

# LXC deployment: set DATABASE_URL in /etc/company-brain/backend.env with host 10.0.3.124.
