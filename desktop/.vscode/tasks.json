{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Company Brain: build",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/dotnet.ps1",
        "build", "${workspaceFolder}/CompanyBrain.Client.csproj",
        "--disable-build-servers"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Company Brain: run",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/dotnet.ps1",
        "run", "--no-build", "--project", "${workspaceFolder}/CompanyBrain.Client.csproj"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Company Brain: build",
      "problemMatcher": []
    }
  ]
}
